<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <Import Project="$(ProjectDir)../version.props" />

  <ItemGroup>
    <PackageReference Include="Likvido.EfCore.SqlServerContextFactory" Version="2.0.20" />
    <PackageReference Include="Likvido.Robot" Version="2.3.38" />
  </ItemGroup>

  <!-- The expand/contract helpers. Split into their own package because the projects that hold a DbContext
       have to call IsMigrationsModel() and cannot take this package's dependency on Likvido.Robot - see that
       project's csproj for the full reason. A ProjectReference rather than a PackageReference so a local
       build needs nothing published; `dotnet pack` turns it into a package dependency at the same version,
       since both projects import the one version.props. -->
  <ItemGroup>
    <ProjectReference Include="..\Likvido.EfCore.MigrationsModel\Likvido.EfCore.MigrationsModel.csproj" />
  </ItemGroup>

</Project>
