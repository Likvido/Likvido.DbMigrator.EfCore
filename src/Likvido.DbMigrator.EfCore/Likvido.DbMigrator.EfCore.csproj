<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <Import Project="$(ProjectDir)../version.props" />

  <ItemGroup>
    <PackageReference Include="Likvido.EfCore.SqlServerContextFactory" Version="2.1.0" />
    <PackageReference Include="Likvido.Robot" Version="3.0.0" />
    <!-- AIKIDO-2026-11098: System.IdentityModel.Tokens.Jwt < 8.19.0 can parse stale ArrayPool bytes as
         claims. Microsoft.Data.SqlClient 7 (via EF Core 11) brings in 8.16.0 through
         Microsoft.IdentityModel.Protocols.OpenIdConnect, so pin both above the cutoff, together, to keep
         the Microsoft.IdentityModel packages on one version. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <!-- The expand/contract helpers. They are a separate package because the gate is written in whichever
       project holds the DbContext, and that code must not inherit this package's dependencies - see that
       project for the rule. A ProjectReference rather than a PackageReference so a local build needs
       nothing published; `dotnet pack` turns it into a package dependency at the same version, since both
       projects import the one version.props. -->
  <ItemGroup>
    <ProjectReference Include="..\Likvido.EfCore.MigrationsModel\Likvido.EfCore.MigrationsModel.csproj" />
  </ItemGroup>

</Project>
