<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- ⚠️ Required by xunit v3: a v3 test project is a self-hosting executable rather than a library the
         runner loads. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- ⚠️ `compile` is in the asset list, unlike the default this package documents. Its build props
         register GitHubActionsTestLogger.MtpIntegration as a Microsoft.Testing.Platform builder hook and
         xunit v3 generates a SelfRegisteredExtensions.cs naming that type, so without `compile` the build
         fails with CS0400 pointing at obj/. -->
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- ⚠️ Referenced only to lift a transitive version. xunit.v3 3.2.2 brings Microsoft.Testing.Platform
         1.9.1 while GitHubActionsTestLogger 3.0.5's hook is compiled against 2.0.0, so the entry point xunit
         generates fails with CS1705 on the mismatch. -->
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.3.3" />
    <!-- The provider the estate actually migrates against. No database is opened: every test here builds a
         model and inspects it, which EF does without connecting. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Likvido.EfCore.MigrationsModel\Likvido.EfCore.MigrationsModel.csproj" />
  </ItemGroup>

</Project>
