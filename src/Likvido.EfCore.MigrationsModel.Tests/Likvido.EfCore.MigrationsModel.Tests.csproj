<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- ⚠️ Required by xunit v3: a v3 test project is a self-hosting executable rather than a library the
         runner loads. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- ⚠️ `compile` is in the asset list, unlike the default this package documents. Its build props
         register GitHubActionsTestLogger.MtpIntegration as a Microsoft.Testing.Platform builder hook and
         xunit v3 generates a SelfRegisteredExtensions.cs naming that type, so without `compile` the build
         fails with CS0400 pointing at obj/. -->
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Likvido.EfCore.MigrationsModel\Likvido.EfCore.MigrationsModel.csproj" />
  </ItemGroup>

  <!-- The provider the estate actually migrates against. No database is opened: every test here builds a
       model and inspects it, which EF does without connecting. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <!-- AIKIDO-2026-11098: System.IdentityModel.Tokens.Jwt < 8.19.0 can parse stale ArrayPool bytes as
         claims. Microsoft.Data.SqlClient 7 (via EF Core 11) brings in 8.16.0 through
         Microsoft.IdentityModel.Protocols.OpenIdConnect, so pin both above the cutoff, together, to keep
         the Microsoft.IdentityModel packages on one version. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
</Project>
